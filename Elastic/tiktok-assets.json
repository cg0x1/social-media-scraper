{
  "settings": {
    "index": {
      "codec": "best_compression",
      "number_of_shards": 1,
      "number_of_replicas": 1,
      "refresh_interval": "30s"
    },
    "analysis": {
      "normalizer": {
        "lc_norm": {
          "type": "custom",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": false,
    "properties": {
      "asset_id": { "type": "keyword" },
      "id": { "type": "keyword" },
      "display_id": { "type": "keyword" },
      "channel": { "type": "keyword", "normalizer": "lc_norm" },
      "channel_id": { "type": "keyword" },
      "uploader": { "type": "keyword", "normalizer": "lc_norm" },
      "uploader_id": { "type": "keyword" },
      "playlist": { "type": "keyword", "normalizer": "lc_norm" },
      "playlist_id": { "type": "keyword" },
      "playlist_title": { "type": "keyword", "normalizer": "lc_norm" },
      "title": {
        "type": "text",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 512 }
        }
      },
      "description": { "type": "text" },
      "artists": { "type": "keyword", "normalizer": "lc_norm", "ignore_above": 512 },
      "view_count": { "type": "long" },
      "like_count": { "type": "long" },
      "comment_count": { "type": "long" },
      "repost_count": { "type": "long" },
      "upload_date": { "type": "date", "format": "yyyyMMdd||strict_date_optional_time" },
      "timestamp": { "type": "date" },
      "duration": { "type": "integer" },
      "track": { "type": "keyword" },
      "webpage_url": { "type": "keyword" },
      "original_url": { "type": "keyword" },
      "channel_url": { "type": "keyword" },
      "uploader_url": { "type": "keyword" },
      "playlist_webpage_url": { "type": "keyword" },
      "thumbnail": { "type": "keyword" },
      "thumbnails": { "type": "object", "enabled": false },
      "subtitles": { "type": "object", "enabled": false },
      "transcript_lang": { "type": "keyword", "normalizer": "lc_norm" },
      "transcript_text": { "type": "text" },
      "transcript_hashes": { "type": "keyword" },
      "transcript_lines": {
        "type": "nested",
        "properties": {
          "offset_ms": { "type": "integer" },
          "duration_ms": { "type": "integer" },
          "total_ticks": { "type": "long" },
          "content": { "type": "text" },
          "content_hash": { "type": "keyword" }
        }
      }
    }
  }
}
