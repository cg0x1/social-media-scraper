{
  "settings": {
    "index": {
      "codec": "best_compression",
      "number_of_shards": 1,
      "number_of_replicas": 1,
      "refresh_interval": "30s"
    },
    "analysis": {
      "normalizer": {
        "lc_norm": {
          "type": "custom",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "source_id": { "type": "keyword" },
      "tiktok_user_id": { "type": "keyword" },
      "handle": { "type": "keyword", "normalizer": "lc_norm" },
      "display_name": {
        "type": "text",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 512 }
        }
      },
      "profile_url": { "type": "keyword" },
      "description": {
        "type": "text",
        "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } }
      },
      "following_count": { "type": "long" },
      "follower_count": { "type": "long" },
      "like_count": { "type": "long" },
      "video_count": { "type": "long" },
      "repost_count": { "type": "long" },
      "status": { "type": "keyword" },
      "first_seen": { "type": "date" },
      "last_seen": { "type": "date" },
      "index_date": { "type": "date" },
      "updated_at": { "type": "date" },

      "signals": {
        "type": "object",
        "dynamic": "strict",
        "properties": {
          "website_domains": { "type": "keyword", "normalizer": "lc_norm" },
          "youtube_channel_ids": { "type": "keyword" },
          "instagram_usernames": { "type": "keyword", "normalizer": "lc_norm" },
          "twitter_usernames": { "type": "keyword", "normalizer": "lc_norm" },
          "emails": { "type": "keyword", "normalizer": "lc_norm" }
        }
      }
    }
  }
}
